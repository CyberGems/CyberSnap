<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../../src/CyberSnap/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CyberSnap/CyberSnap.csproj" />
    <None Include="../../src/CyberSnap/App.xaml" Link="AppResources.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../src/CyberSnap/Assets/Icons/*.ico" Link="Assets/Icons/%(Filename)%(Extension)" />
    <Resource Include="../../src/CyberSnap/Assets/CyberSnap_square.png" Link="Assets/CyberSnap_square.png" />
  </ItemGroup>
</Project>
