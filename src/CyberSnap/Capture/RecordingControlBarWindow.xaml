<Window x:Class="CyberSnap.Capture.RecordingControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        Focusable="False"
        ShowActivated="False"
        Height="58"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseDown="Window_PreviewMouseDown">

    <!-- Outer shell: rounded-corner chrome with shadow.
         Width hugs content so the timer sits next to Pause with no dead gap.
         PrimaryBtn is a fixed 128px pill so Start↔Pause does not resize the bar. -->
    <Border x:Name="OuterShell"
            Height="58"
            HorizontalAlignment="Left"
            CornerRadius="8"
            Background="Transparent">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">

            <!-- Shadow plate (receives the DropShadowEffect) -->
            <Border x:Name="ShadowPlate"
                    CornerRadius="8"
                    Background="Transparent"
                    IsHitTestVisible="False"/>

            <!-- Edge ring: 1px padding-ring technique for crisp rounded borders -->
            <Border x:Name="EdgeRing"
                    CornerRadius="8"
                    Padding="1"
                    Background="Transparent"
                    BorderThickness="0">

                <!-- Root: main content area -->
                <Border x:Name="Root"
                        CornerRadius="7"
                        ClipToBounds="True">

                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Grip + chevron -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Format badge -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Timer + size meter -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Action buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- ═══ Leading: grip then chevron, same order as the other docks ═══ -->
                        <StackPanel Grid.Column="0"
                                    x:Name="LeadingCluster"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0">

                            <Border x:Name="GripBtn"
                                    Width="18" Height="40"
                                    Cursor="SizeAll"
                                    Background="Transparent">
                                <UniformGrid x:Name="GripDots"
                                             Columns="2" Rows="3"
                                             Width="8.4" Height="12.6"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False"
                                             SnapsToDevicePixels="True">
                                    <Ellipse Width="2.4" Height="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.4" Height="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.4" Height="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.4" Height="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.4" Height="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="2.4" Height="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </UniformGrid>
                            </Border>

                            <Border x:Name="ModeBtn"
                                    Width="40" Height="36"
                                    CornerRadius="8"
                                    Margin="0,0,2,0"
                                    Cursor="Hand"
                                    Background="Transparent">
                                <Path x:Name="ModeChevron"
                                      Width="28" Height="24"
                                      Stretch="Uniform"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Data="M8,1 L2,6 L8,11 M13,1 L7,6 L13,11"/>
                            </Border>
                        </StackPanel>

                        <!-- ═══ Format badge — idle / live / paused / encoding ═══ -->
                        <Border Grid.Column="1"
                                x:Name="FormatBadge"
                                Height="24"
                                MinWidth="44"
                                CornerRadius="12"
                                Padding="10,0"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                            <TextBlock x:Name="FormatBadgeText"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>

                        <!-- ═══ Timer (dominant) + quieter size · free-disk meter ═══ -->
                        <StackPanel Grid.Column="2"
                                    x:Name="TimerCluster"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,8,0">
                            <TextBlock x:Name="StatusText"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="160"/>
                            <TextBlock x:Name="StorageText"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"/>
                        </StackPanel>

                        <!-- ═══ Action buttons ═══ -->
                        <StackPanel Grid.Column="3"
                                    x:Name="ActionsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">

                            <!-- Separates recording status/storage from transport actions. -->
                            <Border x:Name="StorageDivider"
                                    Width="1" Height="24"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    CornerRadius="1"
                                    IsHitTestVisible="False"/>

                            <!-- Primary action (Record ⇄ Pause ⇄ Resume). Pill shape; fixed
                                 width so it NEVER resizes between ready/recording — icon + text
                                 live inside, label swaps. Compact icon-only in mini hover. -->
                            <Border x:Name="PrimaryBtn"
                                    Width="128" Height="40"
                                    CornerRadius="20"
                                    Margin="4,0,0,0"
                                    Cursor="Hand"
                                    ClipToBounds="True"
                                    Visibility="Visible">
                                <Border.Clip>
                                    <RectangleGeometry x:Name="PrimaryClip"
                                                       RadiusX="20" RadiusY="20"
                                                       Rect="0,0,128,40"/>
                                </Border.Clip>
                                <Grid>
                                    <StackPanel x:Name="PrimaryContent"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Image x:Name="PrimaryIcon"
                                               Width="20" Height="20"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PrimaryText"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                    <!-- Confirm-dock comet: traveling glint on the pill rim. -->
                                    <Rectangle x:Name="StartShine"
                                               RadiusX="20" RadiusY="20"
                                               Fill="Transparent"
                                               StrokeThickness="1.6"
                                               StrokeDashArray="60 128"
                                               StrokeDashCap="Round"
                                               Stroke="Transparent"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Stop: 40×40 to match the primary pill height. Solid rounded
                                 square (not the padded Fluent bitmap) so it reads as a
                                 control, not a tiny glyph next to the scissors. -->
                            <Border x:Name="StopBtn"
                                    Width="40" Height="40"
                                    CornerRadius="10"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    ClipToBounds="True"
                                    Visibility="Visible"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Border x:Name="StopHoldFill"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom"
                                            Height="0"
                                            IsHitTestVisible="False"/>
                                    <Border x:Name="StopGlyph"
                                            Width="18" Height="18"
                                            CornerRadius="3.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Quiet fade-cap divider between Stop (transport) and FPS (setup). -->
                            <Border x:Name="FpsDivider"
                                    Width="1" Height="24"
                                    VerticalAlignment="Center"
                                    Margin="10,0,6,0"
                                    CornerRadius="1"
                                    IsHitTestVisible="False"/>

                            <!-- FPS: immediately to the right of Stop. Stays visible while
                                 recording (disabled) so the button group does not shift. -->
                            <Border x:Name="FpsCombo"
                                    Width="78" Height="30"
                                    CornerRadius="7"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    Cursor="Hand"
                                    Visibility="Visible">
                                <Grid>
                                    <TextBlock x:Name="FpsComboLabel"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="8,0,0,0"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <Path x:Name="FpsChevron"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Width="7" Height="4"
                                          Stretch="Fill"
                                          Data="M0,0 L3.5,4 L7,0"/>
                                </Grid>
                            </Border>

                            <!-- Send-to-trimmer toggle -->
                            <Border x:Name="TrimmerBtn"
                                    Width="36" Height="36"
                                    CornerRadius="8"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Visibility="Visible">
                                <Image x:Name="TrimmerIcon"
                                       Width="22" Height="22"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Cancel button -->
                            <Border x:Name="CancelBtn"
                                    Width="36" Height="36"
                                    CornerRadius="8"
                                    Margin="8,0,10,0"
                                    Cursor="Hand"
                                    Visibility="Visible">
                                <Image x:Name="CancelIcon"
                                       Width="18" Height="18"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- Mini pill border shine: confirm-dock comet on the ring. -->
            <Rectangle x:Name="MiniShineRing"
                       RadiusX="18" RadiusY="18"
                       Fill="Transparent"
                       StrokeThickness="1.6"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"
                       StrokeDashArray="48 110"
                       StrokeDashCap="Round"
                       Stroke="Transparent"/>
        </Grid>
    </Border>
</Window>
