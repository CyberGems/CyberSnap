<Window x:Class="CyberSnap.Capture.RecordingControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        Focusable="False"
        ShowActivated="False"
        Width="598" Height="58">

    <!-- Outer shell: rounded-corner chrome with shadow.
         Fixed size on the shell so the window never re-sizes between phases
         (Start↔Stop content swap would otherwise shift the anchored position). -->
    <Border x:Name="OuterShell"
            Width="598" Height="58"
            CornerRadius="8"
            Background="Transparent"
            Cursor="SizeAll">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">

            <!-- Shadow plate (receives the DropShadowEffect) -->
            <Border x:Name="ShadowPlate"
                    CornerRadius="8"
                    Background="Transparent"
                    IsHitTestVisible="False"/>

            <!-- Edge ring: 1px padding-ring technique for crisp rounded borders -->
            <Border x:Name="EdgeRing"
                    CornerRadius="8"
                    Padding="1"
                    Background="Transparent"
                    BorderThickness="0">

                <!-- Root: main content area -->
                <Border x:Name="Root"
                        CornerRadius="7"
                        ClipToBounds="True"
                        Cursor="SizeAll">

                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Rec dot + phase label -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- FPS combo (ready only) -->
                            <ColumnDefinition Width="*"/>
                            <!-- Status / timer -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Action buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- ═══ Recording dot + phase label ═══ -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <Border x:Name="RecDotGlow"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    Background="Transparent"
                                    IsHitTestVisible="False">
                                <Border x:Name="RecDot"
                                        Width="10" Height="10"
                                        CornerRadius="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="PhaseLabel"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="15"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <!-- ═══ FPS selector (ready phase only) ═══ -->
                        <Border Grid.Column="1"
                                x:Name="FpsCombo"
                                Width="78" Height="30"
                                CornerRadius="7"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Visibility="Visible">
                            <Grid>
                                <TextBlock x:Name="FpsComboLabel"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="8,0,0,0"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                                <!-- Chevron -->
                                <Path x:Name="FpsChevron"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Width="7" Height="4"
                                      Stretch="Fill"
                                      Data="M0,0 L3.5,4 L7,0"/>
                            </Grid>
                        </Border>

                        <!-- ═══ Status / timer text ═══ -->
                        <TextBlock Grid.Column="2"
                                   x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   Margin="8,0,8,0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"/>

                        <!-- ═══ Action buttons ═══ -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0">

                            <!-- Primary action (Record ⇄ Pause ⇄ Resume). Fixed width 110 so it
                                 NEVER resizes between modes — icon + text live inside, label swaps.
                                 Always visible in both ready and recording phases. -->
                            <Border x:Name="PrimaryBtn"
                                    Width="110" Height="40"
                                    CornerRadius="8"
                                    Margin="10,0,0,0"
                                    Cursor="Hand"
                                    ClipToBounds="True"
                                    Visibility="Visible">
                                <Grid ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Image x:Name="PrimaryIcon"
                                               Width="14" Height="14"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PrimaryText"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                    <!-- Shine sweep overlay: inside the clipped grid so it never
                                         expands the visual beyond the button bounds -->
                                    <Border x:Name="StartShine"
                                            Width="60"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Opacity="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="StartShineTransform" X="-80" Y="0"/>
                                        </Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00A8AEB8" Offset="0"/>
                                                <GradientStop Color="#66A8AEB8" Offset="0.35"/>
                                                <GradientStop Color="#AAD2D7DE" Offset="0.5"/>
                                                <GradientStop Color="#66A8AEB8" Offset="0.65"/>
                                                <GradientStop Color="#00A8AEB8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Stop button: ALWAYS visible (both ready and recording) with a red
                                 square icon of accessible size. In ready phase it is disabled. -->
                            <Border x:Name="StopBtn"
                                    Width="36" Height="36"
                                    CornerRadius="8"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Visibility="Visible">
                                <Image x:Name="StopIcon"
                                       Width="16" Height="16"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Send-to-trimmer toggle -->
                            <Border x:Name="TrimmerBtn"
                                    Width="36" Height="36"
                                    CornerRadius="8"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Visibility="Visible">
                                <Image x:Name="TrimmerIcon"
                                       Width="18" Height="18"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Cancel button -->
                            <Border x:Name="CancelBtn"
                                    Width="36" Height="36"
                                    CornerRadius="8"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Visibility="Visible">
                                <Image x:Name="CancelIcon"
                                       Width="18" Height="18"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
