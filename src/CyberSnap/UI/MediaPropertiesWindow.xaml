<Window x:Class="CyberSnap.UI.MediaPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberSnap.UI.Controls"
        Title="Properties"
        Width="520" SizeToContent="Height"
        MinWidth="420" MaxHeight="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/Icons/Trimmer.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#0CFFFFFF"/>

        <Style x:Key="PropsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
            BorderThickness="1"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:CyberSnapTitleBar x:Name="PropsTitleBar"
                                        Grid.Row="0"
                                        Title="Properties"
                                        CloseRequested="TitleBar_CloseRequested"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="480"
                          Margin="20,8,20,8">
                <StackPanel x:Name="RowsHost"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,4,20,16">
                <Button x:Name="CopyAllBtn"
                        Content="Copy"
                        Style="{StaticResource PropsButtonStyle}"
                        Margin="0,0,8,0"
                        Click="CopyAllBtn_Click"/>
                <Button x:Name="CloseBtn"
                        Content="Close"
                        Style="{StaticResource PropsButtonStyle}"
                        IsDefault="True"
                        Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
