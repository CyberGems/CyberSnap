<Window x:Class="CyberSnap.UI.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberSnap.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:Services="clr-namespace:CyberSnap.Services"
        Title="Achievements ᐧ CyberSnap"
        Height="680" Width="760"
        MinHeight="480" MinWidth="560"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/Icons/CyberSnap.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="ThemeMutedBrush" Color="#FF686868"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="ThemeTabActiveBrush" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="ThemeTabHoverBrush" Color="#0EFFFFFF"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="ThemePanelBackgroundBrush" Color="#FF0D0F17"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#0CFFFFFF"/>

        <Style TargetType="ScrollViewer">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
    </Window.Resources>

    <Border Margin="1" CornerRadius="10">
        <Border x:Name="OuterBorder" CornerRadius="10" ClipToBounds="True" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:CyberSnapTitleBar x:Name="AchievementsTitleBar" Grid.Row="0"
                                            Title="Achievements"
                                            CloseRequested="TitleBar_CloseRequested"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,16,24,24">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Your progress" Style="{StaticResource SectionLabel}"
                                   Services:LocalizationService.SourceText="Your progress"/>

                        <Border Padding="20,16,20,18" CornerRadius="12" Margin="0,0,0,16"
                                Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1">
                            <!-- MinHeight (not fixed Height) so the caption chips under the rail can grow the card. -->
                            <Grid x:Name="MilestoneRailHost" MinHeight="74"/>
                        </Border>

                        <Border Padding="20,16,20,18" CornerRadius="12" Margin="0,0,0,16"
                                Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Services:LocalizationService.SourceText="Statistics"
                                           Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                <Grid x:Name="AchievementsStatsHost"
                                      HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="20,16,20,18" CornerRadius="12"
                                Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Services:LocalizationService.SourceText="Medals"
                                           Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <StackPanel x:Name="AchievementsMedalsHost"
                                            HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</Window>
