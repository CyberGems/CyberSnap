<Window x:Class="CyberSnap.UI.TrayContextMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Services="clr-namespace:CyberSnap.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Width="290"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowActivated="True"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Editor-style tiles: chromeless at rest, but on hover they adopt the original
             ThemeCardBrush fill the tile had at rest before the restyle, WITHOUT the accent
             ring. Matches the Salir hover treatment the user asked us to mimic. -->

        <!-- Large primary tile (Area / Grabar) -->
        <Style x:Key="GridButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact secondary tile (icon + label in one row). Same chromeless rest, same hover feel. -->
        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact header action (Settings beside the close button). -->
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Exit button style — chromeless at rest (icon is the only red element); hover/press
             reclaim the original soft red wash (#15EF4444 / #25EF4444) the user already likes,
             without any accent/danger border. -->
        <Style x:Key="BottomDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BottomButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Background="{DynamicResource ThemeInputBackgroundBrush}"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="3" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="4,2,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AboutHeaderBtn"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        CornerRadius="6"
                        Padding="4,2"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Open About CyberSnap"
                        Services:LocalizationService.SourceToolTip="Open About CyberSnap"
                        ToolTipService.InitialShowDelay="400"
                        ToolTipService.BetweenShowDelay="0"
                        MouseLeftButtonUp="AboutHeader_Click"
                        MouseEnter="AboutHeader_MouseEnter"
                        MouseLeave="AboutHeader_MouseLeave">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="AppLogoImage" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center" Opacity="0.82" Stretch="Uniform"/>
                        <TextBlock x:Name="TitleTextBlock"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <Ellipse x:Name="UpdateLed"
                                 Width="8"
                                 Height="8"
                                 Fill="#22C55E"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#22C55E" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsBtn"
                        Grid.Column="1"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        Click="Settings_Click"
                        ToolTip="Configuration"
                        Services:LocalizationService.SourceToolTip="Configuration">
                    <Image x:Name="SettingsIcon" Width="17" Height="17"/>
                </Button>
                <Button x:Name="TrayCloseBtn"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        MouseEnter="TrayCloseBtn_MouseEnter"
                        Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabHoverBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                          Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                          StrokeThickness="1.5"
                          Width="10"
                          Height="10"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Grid Tools -->
            <StackPanel Grid.Row="1">
                <!-- Primary row: Area remains the large default capture tile. -->
                <UniformGrid Columns="2">
                    <!-- Area Capture -->
                    <Button x:Name="AreaCaptureBtn" Style="{StaticResource GridButtonStyle}" Click="AreaCapture_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="AreaCaptureIcon" Width="32" Height="32" Margin="0,0,0,8" HorizontalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock x:Name="AreaCaptureText" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Four capture shortcuts replacing the former large Record tile.
                         This is only a layout host so each button owns its hover state. -->
                    <Grid Margin="2">
                        <UniformGrid Columns="2" Rows="2"
                                     Width="82"
                                     Height="76"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                            <Button x:Name="ScrollQuickBtn" Style="{StaticResource BottomButtonStyle}" Click="ScrollCapture_Click"
                                    ToolTip="Scrolling capture" Height="34" Margin="1">
                                <Image x:Name="ScrollQuickIcon" Width="22" Height="22" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="FullscreenBtn" Style="{StaticResource BottomButtonStyle}" Click="Fullscreen_Click"
                                    ToolTip="Fullscreen capture" Height="34" Margin="1">
                                <Image x:Name="FullscreenIcon" Width="22" Height="22" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="ActiveWindowBtn" Style="{StaticResource BottomButtonStyle}" Click="ActiveWindow_Click"
                                    ToolTip="Active window" Height="34" Margin="1">
                                <Image x:Name="ActiveWindowIcon" Width="22" Height="22" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="RepeatLastAreaBtn" Style="{StaticResource BottomButtonStyle}" Click="RepeatLastArea_Click"
                                    ToolTip="Repeat last area" Height="34" Margin="1">
                                <Image x:Name="RepeatLastAreaIcon" Width="22" Height="22" Stretch="Uniform"/>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </UniformGrid>

                <!-- Separate image-capture shortcuts from video recording controls. -->
                <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}" Margin="8,4,8,4"/>

                <!-- Secondary capture tools — compact tiles matching the bottom rows -->
                <UniformGrid Columns="2">
                    <!-- Screen Recorder (MP4) -->
                    <Button x:Name="VideoRecordBtn" Style="{StaticResource BottomButtonStyle}" Click="VideoRecord_Click" Padding="8,8" Margin="4,2,2,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="VideoRecordIcon" Width="20" Height="20" Margin="0,2,0,0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="VideoRecordText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="GifRecordBtn" Style="{StaticResource BottomButtonStyle}" Click="GifRecord_Click" Padding="8,8" Margin="2,2,4,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="GifRecordIcon" Width="20" Height="20" Margin="0,2,0,0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="GifRecordText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Separator between capture tools and standalone utility tools -->
                <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}" Margin="4,6,4,6"/>

                <UniformGrid Columns="2">
                    <!-- OCR -->
                    <Button x:Name="OcrBtn" Style="{StaticResource BottomButtonStyle}" Click="Ocr_Click" Padding="8,8" Margin="4,2,2,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="OcrIcon" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="OcrText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>

                    <!-- QR & Barcodes -->
                    <Button x:Name="QrBtn" Style="{StaticResource BottomButtonStyle}" Click="QrScan_Click" Padding="8,8" Margin="2,2,4,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="QrIcon" Width="20" Height="20" Margin="0,2,0,0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="QrText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>

                    <!-- Color Picker -->
                    <Button x:Name="ColorPickerBtn" Style="{StaticResource BottomButtonStyle}" Click="ColorPicker_Click" Padding="8,8" Margin="4,2,2,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="ColorPickerIcon" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="ColorPickerText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>

                    <!-- Ruler -->
                    <Button x:Name="RulerBtn" Style="{StaticResource BottomButtonStyle}" Click="Ruler_Click" Padding="8,8" Margin="2,2,4,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="RulerIcon" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="RulerText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Row="2" Height="1" Background="{DynamicResource ThemeSeparatorBrush}" Margin="4,6,4,6"/>

            <!-- Bottom Actions — compact tiles; larger icons/labels for accessibility. -->
            <StackPanel Grid.Row="3">
                <!-- Gallery & Editor in the same row -->
                <UniformGrid Columns="2">
                    <!-- Gallery (left) -->
                    <Button x:Name="GalleryBtn"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="Gallery_Click"
                            Padding="8,8"
                            Margin="4,2,2,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="GalleryIcon" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="GalleryText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>

                    <!-- Editor (right) -->
                    <Button x:Name="AnnotationsBtn"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="Annotations_Click"
                            Padding="8,8"
                            Margin="2,2,4,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="AnnotationsIcon" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="AnnotationsText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Exit & Achievements in the same row -->
                <UniformGrid Columns="2">
                    <!-- Exit (left) -->
                    <Button x:Name="ExitBtn"
                            Style="{StaticResource BottomDangerButtonStyle}"
                            Click="Exit_Click"
                            Padding="8,8"
                            Margin="4,2,2,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="ExitIcon" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="ExitText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>

                    <!-- Achievements (right) -->
                    <Button x:Name="AchievementsBtn"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="Achievements_Click"
                            Padding="8,8"
                            Margin="2,2,4,2">
                        <StackPanel Width="120" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="28" HorizontalAlignment="Center">
                                <Image x:Name="AchievementsIcon" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="AchievementsText"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="84"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
