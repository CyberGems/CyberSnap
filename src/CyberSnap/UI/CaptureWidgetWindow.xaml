<Window x:Class="CyberSnap.UI.CaptureWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CyberSnap.UI"
        xmlns:Services="clr-namespace:CyberSnap.Services"
        Title="CyberSnap Quick Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AutomationProperties.Name="CyberSnap capture widget"
        AutomationProperties.HelpText="Floating capture panel. Hover the edge peek to expand, then pick a capture tool."
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- CyberGems / Cyberpunk Styles -->
        <SolidColorBrush x:Key="WidgetBg" Color="#0D0F1A"/>
        <SolidColorBrush x:Key="WidgetAccent" Color="#00FFFF"/>
        <SolidColorBrush x:Key="WidgetText" Color="#E6F0FF"/>
        <SolidColorBrush x:Key="WidgetTextMuted" Color="#A0B4D2"/>
        <SolidColorBrush x:Key="WidgetBorder" Color="#2000FFFF"/>
        <SolidColorBrush x:Key="WidgetBorderActive" Color="#8000FFFF"/>
        <SolidColorBrush x:Key="WidgetSeparator" Color="#10FFFFFF"/>
        <SolidColorBrush x:Key="WidgetPeekGripBg" Color="#2600FFFF"/>
        <Color x:Key="WidgetAccentColor">#00FFFF</Color>

        <!-- Action Button Style (Larger buttons/margins) -->
        <Style x:Key="WidgetActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ui:PressFeedback.Enabled" Value="True"/>
            <Setter Property="Template" Value="{StaticResource CapturePanelActionTemplate}"/>
        </Style>

        <Style x:Key="WidgetCaptureModeButton" TargetType="Button" BasedOn="{StaticResource WidgetActionButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

    </Window.Resources>

    <!-- Main Container -->
    <Grid x:Name="RootGrid">
        <!-- RenderTransform for sliding animation -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0" Y="0"/>
        </Grid.RenderTransform>

        <!-- The widget is one piece; it peeks from the selected screen edge when collapsed. -->
        <Grid x:Name="LayoutGrid">
            <!-- Main Panel Border -->
            <Border x:Name="MainPanelBorder" Background="{DynamicResource WidgetBg}"
                    BorderBrush="{DynamicResource WidgetBorderActive}" BorderThickness="1" CornerRadius="8"
                    Visibility="Visible">
                <Border.Effect>
                    <!-- Soft neutral drop shadow (SnagIt-like). Needs the transparent halo from
                         ShadowMargin to render; tune BlurRadius/Opacity/ShadowDepth to taste. -->
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <!-- Top outer drag strip -->
                    <Border x:Name="TopDragStrip" Height="8" VerticalAlignment="Top" Background="Transparent" Cursor="SizeAll" Panel.ZIndex="3"/>
                    <!-- Bottom outer drag strip -->
                    <Border x:Name="BottomDragStrip" Height="10" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeAll" Panel.ZIndex="3"/>

                    <Border x:Name="PeekGrip" Background="{DynamicResource WidgetPeekGripBg}" BorderBrush="{DynamicResource WidgetAccent}"
                            BorderThickness="0" Panel.ZIndex="2" IsHitTestVisible="False">
                        <!-- No own glow: the panel's drop shadow covers the peek. Its own effect
                             (clipped before the shadow margin existed) now rendered as a corner ghost. -->
                        <Border x:Name="GripPanel" Background="Transparent"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="GripPill" CornerRadius="1.5" Background="{DynamicResource WidgetTextMuted}"
                                    Width="24" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>

                <ScrollViewer x:Name="ControlsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" Focusable="False">
                <Grid x:Name="ControlsGrid" Margin="12,8,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title Bar: Branding + More -->
                        <RowDefinition Height="Auto"/> <!-- Capture Button -->
                        <RowDefinition Height="Auto"/> <!-- Quick Actions -->
                        <RowDefinition Height="Auto"/> <!-- Gallery and editor -->
                    </Grid.RowDefinitions>

                    <!-- Top Title Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="WidgetBrandingBtn"
                                Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Click="WidgetBranding_Click"
                                MouseEnter="WidgetBranding_MouseEnter"
                                MouseLeave="WidgetBranding_MouseLeave">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="WidgetLogoImage"
                                       Width="11" Height="11"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"/>
                                <TextBlock x:Name="WidgetBrandText"
                                           Text="CyberSnap widget"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WidgetTextMuted}"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Display"/>
                                <Ellipse x:Name="UpdateLed"
                                         Width="7"
                                         Height="7"
                                         Fill="#22C55E"
                                         Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#22C55E" ShadowDepth="0" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </StackPanel>
                        </Button>
                        <Button x:Name="WidgetMoreButton" Grid.Column="1" Style="{StaticResource WidgetActionButton}" Width="24" Height="24" Click="More_Click"
                                Template="{StaticResource CapturePanelHeaderTemplate}"
                                PreviewMouseLeftButtonDown="More_PreviewMouseLeftButtonDown"
                                AutomationProperties.Name="More">
                            <Image x:Name="MoreIcon" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <!-- Primary area capture and optional capture modes. -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CaptureButton" Click="CaptureButton_Click" Cursor="Hand" Height="112" Background="Transparent" FocusVisualStyle="{x:Null}"
                                MouseEnter="CaptureButton_MouseEnter" MouseLeave="CaptureButton_MouseLeave"
                                ui:PressFeedback.Enabled="True"
                                AutomationProperties.Name="Quick screenshot"
                                AutomationProperties.HelpText="Start a quick screenshot using the default capture mode.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CaptureTile" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <Grid Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="CaptureMarkScale"/>
                                        </Grid.RenderTransform>
                                        <Path x:Name="OuterRing" Data="M4.5 3C3.67 3 3 3.67 3 4.5v2a.5.5 0 0 1-1 0v-2A2.5 2.5 0 0 1 4.5 2h2a.5.5 0 0 1 0 1h-2Zm0 14A1.5 1.5 0 0 1 3 15.5v-2a.5.5 0 0 0-1 0v2A2.5 2.5 0 0 0 4.5 18h2a.5.5 0 0 0 0-1h-2ZM17 4.5c0-.83-.67-1.5-1.5-1.5h-2a.5.5 0 0 1 0-1h2A2.5 2.5 0 0 1 18 4.5v2a.5.5 0 0 1-1 0v-2ZM15.5 17c.83 0 1.5-.67 1.5-1.5v-2a.5.5 0 0 1 1 0v2a2.5 2.5 0 0 1-2.5 2.5h-2a.5.5 0 0 1 0-1h2"
                                              Fill="{DynamicResource WidgetAccent}" Stretch="Uniform" Width="62.4" Height="62.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ContentPresenter.Effect>
                                                <DropShadowEffect Color="{DynamicResource WidgetAccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                            </ContentPresenter.Effect>
                                        </ContentPresenter>
                                    </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CaptureTile" Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CaptureTile" Property="Background" Value="{DynamicResource ThemeTabActiveBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Image x:Name="BigCaptureIcon" Width="23.1" Height="23.1"/>
                        </Button>
                        <Grid x:Name="AreaModeCaption" VerticalAlignment="Bottom" Height="32" Margin="0,0,0,8" IsHitTestVisible="False">
                            <TextBlock x:Name="AreaModeLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WidgetText}"/>
                        </Grid>
                        <StackPanel x:Name="CaptureModeButtons" Grid.Column="1" Width="92" Margin="4,0,0,0"
                                    VerticalAlignment="Center" TextBlock.FontSize="12">
                            <Button x:Name="FullscreenModeButton" Style="{StaticResource WidgetCaptureModeButton}" Click="FullscreenMode_Click">
                                <StackPanel Orientation="Horizontal" Margin="6,0,3,0">
                                    <Image x:Name="FullscreenModeIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="FullscreenModeLabel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="WindowModeButton" Style="{StaticResource WidgetCaptureModeButton}" Click="WindowMode_Click">
                                <StackPanel Orientation="Horizontal" Margin="6,0,3,0">
                                    <Image x:Name="WindowModeIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="WindowModeLabel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RepeatModeButton" Style="{StaticResource WidgetCaptureModeButton}" Click="RepeatMode_Click">
                                <StackPanel Orientation="Horizontal" Margin="6,0,3,0">
                                    <Image x:Name="RepeatModeIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="RepeatModeLabel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Three capture actions, followed by two rows of utility tools. -->
                    <Grid x:Name="QuickActionsGrid" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <Button x:Name="ScrollToolButton" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="ScrollCapture_Click"
                                    AutomationProperties.Name="Scrolling capture">
                                <Image x:Name="ScrollCaptureIcon" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="VideoToolButton" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="ScreenRecord_Click"
                                    AutomationProperties.Name="Record screen video">
                                <Image x:Name="ScreenRecordIcon" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="GifToolButton" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="GifRecord_Click"
                                    AutomationProperties.Name="Record animated GIF">
                                <Image x:Name="GifRecordIcon" Width="22" Height="22"/>
                            </Button>
                        <StackPanel x:Name="ToolsBlock" Grid.Row="1" Grid.ColumnSpan="3">
                            <Border x:Name="ToolsSeparator" Height="1" Margin="4,7,4,7" Background="{DynamicResource WidgetSeparator}"/>
                            <UniformGrid Columns="3">
                            <Button x:Name="OcrToolButton" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="GrabText_Click"
                                    AutomationProperties.Name="Extract text OCR">
                                <Image x:Name="GrabTextIcon" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="ColorToolButton" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="ColorPicker_Click"
                                    AutomationProperties.Name="Color picker">
                                <Image x:Name="ColorPickerIcon" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="QrToolButton" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="QrScan_Click"
                                    AutomationProperties.Name="QR and Barcodes">
                                <Image x:Name="QrScanIcon" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="RulerToolButton" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="Ruler_Click"
                                    AutomationProperties.Name="Ruler">
                                <Image x:Name="RulerIcon" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="ZoomToolButton" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="Zoom_Click"
                                    AutomationProperties.Name="Zoom">
                                <Image x:Name="ZoomIcon" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="PinToolButton" HorizontalAlignment="Center" Style="{StaticResource WidgetActionButton}" Click="Pin_Click"
                                    AutomationProperties.Name="Pin to screen">
                                <Image x:Name="PinIcon" Width="22" Height="22"/>
                            </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="GalleryEditorBlock" Grid.Row="3" Margin="0,10,0,0" TextBlock.FontSize="12" TextBlock.FontWeight="SemiBold">
                        <Border Height="1" Margin="4,0,4,7" Background="{DynamicResource WidgetSeparator}"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="GalleryShortcutButton" Style="{StaticResource WidgetCaptureModeButton}"
                                    HorizontalContentAlignment="Center" Click="GalleryShortcut_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="GalleryShortcutIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="GalleryShortcutLabel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditorShortcutButton" Style="{StaticResource WidgetCaptureModeButton}"
                                    HorizontalContentAlignment="Center" Click="EditorShortcut_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="EditorShortcutIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="EditorShortcutLabel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                </Grid>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
