<Window x:Class="CyberSnap.UI.QrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberSnap.UI.Controls"
        Title="QR &amp; Barcode Scanner"
        Height="440" Width="560"
        MinHeight="340" MinWidth="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="False"
        Icon="pack://application:,,,/Assets/Icons/QR.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="ThemeMutedBrush" Color="#FF686868"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#0CFFFFFF"/>
        <Geometry x:Key="CopyIconGeometry">M10,8 H20 A2,2 0 0 1 22,10 V20 A2,2 0 0 1 20,22 H10 A2,2 0 0 1 8,20 V10 A2,2 0 0 1 10,8 Z M4,16 A2,2 0 0 1 2,14 V4 A2,2 0 0 1 4,2 H14 A2,2 0 0 1 16,4</Geometry>

        <Style x:Key="QrPrimaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QrCopyButton" TargetType="Button" BasedOn="{StaticResource ChromeButtonBase}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="QrTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Malgun Gothic, Yu Gothic UI, Arial Unicode MS, Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:CyberSnapTitleBar x:Name="QrTitleBar" Grid.Row="0"
                                        Title="QR &amp; Barcode Scanner ⋅ CyberSnap"
                                        CloseRequested="TitleBar_CloseRequested"/>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,10,0"
                        Background="{DynamicResource ThemeCardBrush}"
                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10">
                    <Grid>
                        <Border Background="{DynamicResource ThemeInputBackgroundBrush}"
                                CornerRadius="6">
                            <Grid x:Name="CheckerboardHost"/>
                        </Border>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="PreviewUnavailableText"
                                   Text="Source preview unavailable"
                                   Foreground="{DynamicResource ThemeMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,1,0,8">
                        <TextBlock x:Name="DetectedTypeLabel"
                                   Text="Detected type"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="FormatBadge"
                                Margin="8,0,0,0"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="{DynamicResource ThemeAccentHoverBrush}"
                                BorderBrush="{DynamicResource ThemeAccentBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="FormatText"
                                       Text="QR Code"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="ContentLabel"
                               Text="Code content"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBox Grid.Row="2" x:Name="ContentTextBox"
                             Style="{StaticResource QrTextBox}"
                             IsReadOnly="True"
                             Text=""/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <TextBlock x:Name="CopyStatusText"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button x:Name="CopyButton"
                                Click="CopyButton_Click"
                                Style="{StaticResource QrCopyButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="CopyIcon"
                                      Data="{StaticResource CopyIconGeometry}"
                                      Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                      StrokeThickness="2.2"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="CopyButtonText"
                                           Text="Copy and close"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
