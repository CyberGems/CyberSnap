<Window x:Class="CyberSnap.UI.UpdateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberSnap.UI.Controls"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="Transparent" SizeToContent="Height" Width="480"
        FontFamily="Segoe UI Variable Text" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border CornerRadius="12" BorderThickness="1" Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeWindowBorderBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ThemeAccentSubtleBrush}"
                            VerticalAlignment="Top" Margin="0,0,10,0">
                        <Image x:Name="AppLogo" Width="24" Height="24"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="StageTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="DismissButton" Grid.Column="2" Width="28" Height="28" VerticalAlignment="Top"
                            Click="Dismiss_Click" Padding="0">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                </Grid>

                <Border Padding="10,8" CornerRadius="7" BorderThickness="1" Margin="0,0,0,10"
                        Background="{DynamicResource ThemeInputBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeInputBorderBrush}">
                    <StackPanel>
                        <TextBlock x:Name="NotesTitle" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="NotesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NotesUnavailable" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="DownloadPanel" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" Margin="0,0,0,4" FontSize="12"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressBar" Height="6" Maximum="100"
                                 Foreground="{DynamicResource ThemeAccentBrush}"
                                 Background="{DynamicResource ThemeInputBackgroundBrush}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>

                <controls:RightAlignedWrapPanel>
                    <Button x:Name="GithubButton" Height="32" Padding="10,0" Margin="0,4,6,0" Click="Github_Click"/>
                    <Button x:Name="SkipButton" Height="32" Padding="10,0" Margin="0,4,6,0" Click="Skip_Click"/>
                    <Button x:Name="LaterButton" Height="32" Padding="10,0" Margin="0,4,6,0" Click="Dismiss_Click"/>
                    <Button x:Name="CancelButton" Height="32" Padding="10,0" Margin="0,4,0,0" Click="Cancel_Click"/>
                    <Button x:Name="PrimaryButton" Height="32" Padding="10,0" Margin="0,4,0,0" Click="Primary_Click"
                            Style="{DynamicResource CyberSnapAccentButton}"/>
                </controls:RightAlignedWrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
