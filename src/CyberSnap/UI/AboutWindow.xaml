<Window x:Class="CyberSnap.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberSnap.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:Services="clr-namespace:CyberSnap.Services"
        Title="About ᐧ CyberSnap"
        Height="590" Width="740"
        MinHeight="480" MinWidth="600"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/Icons/CyberSnap.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="ThemeMutedBrush" Color="#FF686868"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="ThemeTabActiveBrush" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="ThemeTabHoverBrush" Color="#0EFFFFFF"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="ThemePanelBackgroundBrush" Color="#FF0D0F17"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#0CFFFFFF"/>
        <sys:Double x:Key="SettingsControlHeight">30</sys:Double>
        <Thickness x:Key="SettingsControlPadding">10,5</Thickness>
        <sys:Double x:Key="SettingsControlFontSize">12</sys:Double>
        <sys:Double x:Key="SettingsControlMinWidth">88</sys:Double>

        <Style TargetType="ScrollViewer">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Themed scrollbar (same as Settings, History, Achievements) -->
        <Style x:Key="SettingsScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="3" Background="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,2,8,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="{TemplateBinding Width}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,6,0,6">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SettingsScrollBarStyle}"/>

        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Opacity" Value="0.68"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingDescription" TargetType="TextBlock" BasedOn="{StaticResource InfoText}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="SettingsProgressText" TargetType="TextBlock" BasedOn="{StaticResource InfoText}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SettingIconFrame" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ChromeButtonBase}">
            <Setter Property="Height" Value="{StaticResource SettingsControlHeight}"/>
            <Setter Property="MinHeight" Value="{StaticResource SettingsControlHeight}"/>
            <Setter Property="MinWidth" Value="{StaticResource SettingsControlMinWidth}"/>
            <Setter Property="Padding" Value="{StaticResource SettingsControlPadding}"/>
            <Setter Property="FontSize" Value="{StaticResource SettingsControlFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="40"
                                Height="20"
                                CornerRadius="10"
                                Background="#00000000"
                                BorderBrush="{DynamicResource ThemeTextSecondaryBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Rectangle x:Name="Thumb"
                                     Width="12"
                                     Height="12"
                                     Margin="4,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource ThemeTextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeTabHoverBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AboutFooterIconButton" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Border Margin="1" CornerRadius="10">
    <Border x:Name="OuterBorder" CornerRadius="10" ClipToBounds="True" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:CyberSnapTitleBar x:Name="AboutTitleBar" Grid.Row="0"
                                  Title="About ⋅ CyberSnap"
                                  CloseRequested="TitleBar_CloseRequested"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="18,12,18,18">
            <StackPanel>
                <!-- Hero: branding + description -->
                <Grid Margin="0,4,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="20" Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1.5">
                            <Image Width="52" Height="52" Stretch="Uniform"
                                   Source="pack://application:,,,/Assets/CyberSnap_square.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="32" FontWeight="Bold" FontFamily="Segoe UI Variable Display">
                                <Run Text="Cyber" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/><Run Text="Snap" Foreground="#6ACBDC"/>
                            </TextBlock>
                            <TextBlock x:Name="AboutVersionText" FontSize="14" Opacity="0.5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                            Background="{DynamicResource ThemeCardBrush}"
                            BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="22,18"
                            Margin="36,0,0,0">
                        <TextBlock x:Name="AboutDescriptionText"
                                   FontSize="13"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   Opacity="0.78"
                                   LineHeight="24"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap"
                                   TextOptions.TextFormattingMode="Display"
                                   Services:LocalizationService.SourceText="CyberSnap is a professional screen capture suite for fast workflows — local OCR, instant translation, and a full gallery.">
                            CyberSnap is a professional screen capture suite for fast workflows — local OCR, instant translation, and a full gallery.
                        </TextBlock>
                    </Border>
                </Grid>

                <TextBlock x:Name="AboutUpdatesSectionLabel" Text="Updates &amp; Maintenance" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" Services:LocalizationService.SourceText="Updates &amp; Maintenance"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingIconFrame}">
                                <TextBlock Text="&#xE777;" Style="{StaticResource SettingIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="AboutAutoUpdateTitle" Text="Check for updates on startup" Style="{StaticResource SettingTitle}" Services:LocalizationService.SourceText="Check for updates on startup"/>
                                <TextBlock x:Name="AboutAutoUpdateDesc" Text="Automatically check for new versions when CyberSnap starts." Style="{StaticResource SettingDescription}" Services:LocalizationService.SourceText="Automatically check for new versions when CyberSnap starts."/>
                            </StackPanel>
                            <CheckBox x:Name="AutoCheckUpdateCheck" Grid.Column="2" Content="" FontSize="13" VerticalAlignment="Center"
                                      AutomationProperties.Name="Check for updates on startup"
                                      ToolTip="Automatically check for new versions when CyberSnap starts."
                                      Services:LocalizationService.SourceToolTip="Automatically check for new versions when CyberSnap starts."
                                      Checked="AutoCheckUpdateCheck_Changed" Unchecked="AutoCheckUpdateCheck_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ThemeSeparatorBrush}" Margin="0,9,0,9"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingIconFrame}">
                                <TextBlock Text="&#xE896;" Style="{StaticResource SettingIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="AboutUpdateTitle" Text="Check for updates" Style="{StaticResource SettingTitle}" Services:LocalizationService.SourceText="Check for updates"/>
                                <TextBlock x:Name="AboutUpdateDesc" Text="Check for the latest version and download updates directly." Style="{StaticResource SettingDescription}" Services:LocalizationService.SourceText="Check for the latest version and download updates directly."/>
                            </StackPanel>
                            <Button x:Name="UpdateBtn" Content="Check Now" Grid.Column="2" MinWidth="108"
                                    Services:LocalizationService.SourceContent="Check Now"
                                    VerticalAlignment="Center" Click="UpdateCheckButton_Click" Cursor="Hand"
                                    ToolTip="Check for the latest version"
                                    Services:LocalizationService.SourceToolTip="Check for the latest version"
                                    AutomationProperties.Name="Check for Updates"/>
                        </Grid>

                        <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="38,8,0,8">
                            <TextBlock x:Name="UpdateProgressText" Text="Downloading update..." Style="{StaticResource SettingsProgressText}" Margin="0,0,0,6" Services:LocalizationService.SourceText="Downloading update..."/>
                            <ProgressBar x:Name="UpdateProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource ThemeAccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: CyberGems link + GitHub / Issues / Releases (CyberNotes pattern) -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeSeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,10"
                Background="#1F000000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="AboutFooterCopyright"
                           Grid.Column="0"
                           Text="© CyberGems • 2026"
                           FontSize="10"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Text"
                           Foreground="{DynamicResource ThemeMutedBrush}"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           ToolTip="Visit CyberGems website"
                           Services:LocalizationService.SourceToolTip="Visit CyberGems website"
                           MouseLeftButtonUp="AboutFooterWebsite_Click"
                           MouseEnter="AboutFooterCopyright_MouseEnter"
                           MouseLeave="AboutFooterCopyright_MouseLeave"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AboutFooterWebsiteBtn"
                            Style="{StaticResource AboutFooterIconButton}"
                            ToolTip="Visit CyberGems website"
                            Services:LocalizationService.SourceToolTip="Visit CyberGems website"
                            MouseLeftButtonUp="AboutFooterWebsite_Click"
                            MouseEnter="AboutFooterIcon_MouseEnter"
                            MouseLeave="AboutFooterIcon_MouseLeave">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <!-- Open-external (box + arrow) — clearer “website” cue than a filled globe -->
                            <Canvas x:Name="AboutFooterWebsiteIconCanvas" Width="20" Height="20">
                                <Path x:Name="AboutFooterWebsiteBox"
                                      Stroke="{DynamicResource ThemeMutedBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" Fill="Transparent"
                                      Data="M4.5 7.5V15.5A1.5 1.5 0 0 0 6 17h8.5A1.5 1.5 0 0 0 16 15.5V12"/>
                                <Path x:Name="AboutFooterWebsiteArrow"
                                      Stroke="{DynamicResource ThemeMutedBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M10.5 3.5H16.5V9.5M16.2 3.8L9 11"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Border x:Name="AboutFooterGithubBtn"
                            Style="{StaticResource AboutFooterIconButton}"
                            ToolTip="View project on GitHub"
                            Services:LocalizationService.SourceToolTip="View project on GitHub"
                            MouseLeftButtonUp="AboutFooterGithub_Click"
                            MouseEnter="AboutFooterIcon_MouseEnter"
                            MouseLeave="AboutFooterIcon_MouseLeave">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Path x:Name="AboutFooterGithubIcon" Fill="{DynamicResource ThemeMutedBrush}"
                                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                        </Viewbox>
                    </Border>
                    <Border x:Name="AboutFooterIssuesBtn"
                            Style="{StaticResource AboutFooterIconButton}"
                            ToolTip="Report a bug or open an issue"
                            Services:LocalizationService.SourceToolTip="Report a bug or open an issue"
                            MouseLeftButtonUp="AboutFooterIssues_Click"
                            MouseEnter="AboutFooterIcon_MouseEnter"
                            MouseLeave="AboutFooterIcon_MouseLeave">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Ellipse x:Name="AboutFooterIssuesRing" Width="18" Height="18" Canvas.Left="3" Canvas.Top="3"
                                         Stroke="{DynamicResource ThemeMutedBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <Ellipse x:Name="AboutFooterIssuesDot" Width="4" Height="4" Canvas.Left="10" Canvas.Top="10"
                                         Fill="{DynamicResource ThemeMutedBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Border x:Name="AboutFooterReleasesBtn"
                            Style="{StaticResource AboutFooterIconButton}"
                            ToolTip="View releases and changelogs"
                            Services:LocalizationService.SourceToolTip="View releases and changelogs"
                            MouseLeftButtonUp="AboutFooterReleases_Click"
                            MouseEnter="AboutFooterIcon_MouseEnter"
                            MouseLeave="AboutFooterIcon_MouseLeave">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="AboutFooterTagBody" Stroke="{DynamicResource ThemeMutedBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" Fill="Transparent"
                                      Data="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.41 2.41 0 0 0 3.408 0l5.586-5.586a2.41 2.41 0 0 0 0-3.408z"/>
                                <Ellipse x:Name="AboutFooterTagDot" Width="2.5" Height="2.5" Canvas.Left="6" Canvas.Top="6.5"
                                         Fill="{DynamicResource ThemeMutedBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
    </Border>
</Window>
