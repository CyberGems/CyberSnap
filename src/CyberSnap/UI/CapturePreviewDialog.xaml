<Window x:Class="CyberSnap.UI.CapturePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberSnap.UI.Controls"
        xmlns:ui="clr-namespace:CyberSnap.UI"
        Title="Capture Preview"
        Height="520" Width="860"
        MinHeight="440" MinWidth="580"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="False"
        Icon="pack://application:,,,/Assets/Icons/Preview.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="ThemeMutedBrush" Color="#FF686868"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="ThemePrimaryButtonForegroundBrush" Color="#FF0B1220"/>
        <SolidColorBrush x:Key="ThemePrimaryCtaBorderBrush" Color="#3800FFFF"/>

        <Style x:Key="PreviewActionButton" TargetType="Button" BasedOn="{StaticResource ChromeButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="9,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewIconButton" TargetType="Button" BasedOn="{StaticResource ChromeButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewZoomPercentButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSubtleBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewScaleButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewScaleButtonActive" TargetType="Button" BasedOn="{StaticResource PreviewScaleButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryButtonForegroundBrush}"/>
        </Style>

        <Style x:Key="PreviewPrimaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="16,10"/>
            <!-- Quiet fill; accent hairline (applied in code) carries the CTA hierarchy. -->
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryCtaBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:CyberSnapTitleBar x:Name="TitleBar" Grid.Row="0"
                                      Title="Capture Preview ⋅ CyberSnap"
                                      ShowPinButton="True"
                                      CloseRequested="TitleBar_CloseRequested"
                                      PinRequested="TitleBar_PinRequested"/>

            <ui:PreviewTabStrip x:Name="PreviewTabStripHost" Grid.Row="1"
                                Height="28"
                                Visibility="Collapsed"/>

            <!-- Preview (left) + actions (right); stacks when narrow -->
            <Grid x:Name="MainLayout" Grid.Row="2" Margin="14,2,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewCol" Width="*"/>
                    <ColumnDefinition x:Name="ActionsCol" Width="285"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PreviewRow" Height="*"/>
                    <RowDefinition x:Name="ActionsRow" Height="0"/>
                </Grid.RowDefinitions>

                <!-- Image preview -->
                <Border x:Name="PreviewFrame" Grid.Row="0" Grid.Column="0"
                        Margin="0,0,12,0" CornerRadius="10" Padding="0"
                        BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                        ClipToBounds="True"
                        PreviewMouseWheel="ZoomViewport_PreviewMouseWheel"
                        MouseLeftButtonDown="ZoomViewport_MouseLeftButtonDown"
                        MouseLeftButtonUp="ZoomViewport_MouseLeftButtonUp"
                        MouseMove="ZoomViewport_MouseMove"
                        MouseEnter="ZoomViewport_MouseEnter"
                        MouseLeave="ZoomViewport_MouseLeave"
                        MouseRightButtonUp="PreviewFrame_MouseRightButtonUp">
                    <Grid>
                        <Border x:Name="CheckerboardHost" CornerRadius="9"/>
                        <ScrollViewer x:Name="ZoomViewport"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      PanningMode="None"
                                      Focusable="False">
                            <Grid x:Name="ZoomCanvas" Background="Transparent">
                                <Image x:Name="PreviewImage" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- Zoom controls overlay -->
                        <Border x:Name="ZoomControlsOverlay"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,10,10"
                                Padding="8,5"
                                CornerRadius="8"
                                Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
                                BorderThickness="1"
                                Cursor="Arrow"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ZoomOutBtn" Style="{StaticResource PreviewIconButton}"
                                        Click="ZoomOutBtn_Click"
                                        Width="24" Height="24"
                                        MinWidth="24" MinHeight="24"
                                        Padding="0"
                                        ToolTip="{x:Null}"
                                        AutomationProperties.Name="Zoom out">
                                    <Image x:Name="ZoomOutIcon" Width="12" Height="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="ZoomLevelBtn" Style="{StaticResource PreviewZoomPercentButton}"
                                        Click="ZoomLevelBtn_Click"
                                        Margin="4,0"
                                        ToolTip="{x:Null}"
                                        AutomationProperties.Name="Reset zoom to actual size">
                                    <TextBlock x:Name="ZoomLevelText"
                                               Text="100%"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Button>
                                <Button x:Name="ZoomInBtn" Style="{StaticResource PreviewIconButton}"
                                        Click="ZoomInBtn_Click"
                                        Width="24" Height="24"
                                        MinWidth="24" MinHeight="24"
                                        Padding="0"
                                        ToolTip="{x:Null}"
                                        AutomationProperties.Name="Zoom in">
                                    <Image x:Name="ZoomInIcon" Width="12" Height="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="ZoomFitBtn" Style="{StaticResource PreviewIconButton}"
                                        Click="ZoomFitBtn_Click"
                                        Width="24" Height="24"
                                        MinWidth="24" MinHeight="24"
                                        Padding="0"
                                        Margin="4,0,0,0"
                                        ToolTip="{x:Null}"
                                        AutomationProperties.Name="Fit to window">
                                    <Image x:Name="ZoomFitIcon" Width="12" Height="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Scale controls overlay — bottom-left, same level as zoom -->
                        <Border x:Name="ScaleControlsOverlay"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="10,0,0,10"
                                Padding="6,5"
                                CornerRadius="8"
                                Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
                                BorderThickness="1"
                                Cursor="Arrow"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ScaleLabel"
                                           Text="Scale"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="2,0,6,0"/>
                                <Button x:Name="Scale1xBtn" Style="{StaticResource PreviewScaleButton}"
                                        Click="Scale1xBtn_Click"
                                        Content="1×"
                                        AutomationProperties.Name="1x"/>
                                <Button x:Name="Scale2xBtn" Style="{StaticResource PreviewScaleButton}"
                                        Click="Scale2xBtn_Click"
                                        Content="2×"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="2x"/>
                                <Button x:Name="Scale4xBtn" Style="{StaticResource PreviewScaleButton}"
                                        Click="Scale4xBtn_Click"
                                        Content="4×"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="4x"/>
                                <TextBlock x:Name="ScaleDimensionsText"
                                           Margin="8,0,2,0"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Opacity="0.9"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Decision column -->
                <Border x:Name="ActionsPanel" Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource ThemeCardBrush}"
                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,12,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- On continue -->
                        <StackPanel Grid.Row="0">
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <Button x:Name="EditAfterCaptureSettingsBtn" DockPanel.Dock="Right"
                                        Click="EditAfterCaptureSettingsBtn_Click"
                                        Style="{StaticResource PreviewIconButton}"
                                        Margin="8,0,0,0"
                                        ToolTip="Configure automatic actions"
                                        AutomationProperties.Name="Configure automatic actions">
                                    <Image x:Name="EditSettingsBtnIcon" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock x:Name="AfterCaptureHeaderLabel"
                                           Text="Active actions:"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <StackPanel x:Name="AfterCapturePillsPanel" Orientation="Vertical"/>

                            <TextBlock x:Name="NoAutomaticActionsLabel"
                                       Text="None"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource ThemeMutedBrush}"/>
                        </StackPanel>

                        <!-- You can also — anchored to the bottom, right above the primary CTA,
                             so the breathing room stays under the pills instead of mid-card. -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly" Focusable="False" Margin="0,8,0,0">
                            <StackPanel x:Name="OptionalActionsSection" VerticalAlignment="Top">
                                <TextBlock x:Name="OptionalActionsHeaderLabel"
                                           Text="You can also:"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           Margin="0,0,0,4"
                                           TextTrimming="CharacterEllipsis"/>

                                <WrapPanel x:Name="OptionalActionsPanel" Orientation="Horizontal">
                                    <Button x:Name="SaveBtn" Click="SaveBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="SaveIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="SaveText" Text="Save" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SaveAsBtn" Click="SaveAsBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="SaveAsIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="SaveAsText" Text="Save as..." VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CopyBtn" Click="CopyBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="CopyIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="CopyText" Text="Copy" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="EditBtn" Click="EditBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="EditIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="EditText" Text="Edit" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenViewerBtn" Click="OpenViewerBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="OpenViewerIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="OpenViewerText" Text="Open in viewer" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PrintBtn" Click="PrintBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="PrintIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="PrintText" Text="Print" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteBtn" Click="DeleteBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="DeleteIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="DeleteText" Text="Delete" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="MoreBtn" Click="MoreBtn_Click"
                                            Style="{StaticResource PreviewActionButton}"
                                            Margin="0,0,6,4"
                                            ToolTip="More">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="MoreIcon" Width="13" Height="13" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="MoreText" Text="More" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Hidden action hosts kept for Share/Gallery (opened via More menu) -->
                                <Button x:Name="ShareBtn" Click="ShareBtn_Click" Visibility="Collapsed" Height="0" Width="0" Padding="0"/>
                                <Button x:Name="GalleryBtn" Click="GalleryBtn_Click" Visibility="Collapsed" Height="0" Width="0" Padding="0"/>
                                <Image x:Name="ShareIcon" Width="0" Height="0" Visibility="Collapsed"/>
                                <Image x:Name="GalleryIcon" Width="0" Height="0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Primary CTA + auto-close countdown ring docked right (skip-ad style). -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Grid>
                                <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                                        Style="{StaticResource PreviewPrimaryButton}"
                                        HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch" MinHeight="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="CancelText" Text="Close" VerticalAlignment="Center"
                                                       FontSize="12.5" FontWeight="SemiBold"/>
                                            <!-- Host owns the invite slide so spinner RotateTransform on CancelIcon stays independent. -->
                                            <Grid x:Name="CancelIconHost" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="CancelIconSlide"/>
                                                </Grid.RenderTransform>
                                                <Image x:Name="CancelIcon" Width="16" Height="16"
                                                       RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <ScaleTransform x:Name="CancelIconScale" ScaleX="1" ScaleY="1"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Grid>
                                        </StackPanel>
                                        <!-- Countdown ring around the seconds numeral: the accent arc depletes
                                             clockwise from 12 o'clock as the auto-close timeout runs out. -->
                                        <Grid x:Name="CountdownRingHost"
                                              Grid.Column="2"
                                              Width="24" Height="24"
                                              Margin="10,0,0,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Visibility="Collapsed"
                                              IsHitTestVisible="False">
                                            <Ellipse Stroke="{DynamicResource ThemeInputBorderBrush}"
                                                     StrokeThickness="2.2"/>
                                            <Path x:Name="CountdownRingArc"
                                                  Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                                  StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                            <TextBlock x:Name="AutoCloseCountdownText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <Path x:Name="AutoClosePauseIcon"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"
                                                  Fill="{DynamicResource ThemeTextSecondaryBrush}"
                                                  Data="M2,1 H4 V9 H2 Z M6,1 H8 V9 H6 Z"/>
                                            <Path x:Name="AutoCloseCheckIcon"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M2,6 L5,9 L10,2.5"/>
                                        </Grid>
                                    </Grid>
                                </Button>

                                <!-- Luminous Sheen Layer covering full button geometry -->
                                <Border x:Name="CtaSheenHost" CornerRadius="8" IsHitTestVisible="False">
                                    <Rectangle x:Name="CtaSheenBar"
                                               Width="120"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Stretch"
                                               Margin="-140,-5,0,-5"
                                               IsHitTestVisible="False"
                                               Opacity="0">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush x:Name="CtaSheenBrush" StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                                <GradientStop x:Name="CtaSheenStopEdge1" Color="#15FFFFFF" Offset="0.25"/>
                                                <GradientStop x:Name="CtaSheenStopMid" Color="#45FFFFFF" Offset="0.5"/>
                                                <GradientStop x:Name="CtaSheenStopEdge2" Color="#15FFFFFF" Offset="0.75"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform AngleX="-28"/>
                                                <TranslateTransform x:Name="CtaSheenTranslate" X="0"/>
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="ViewerHintBadge"
                                       Text=""
                                       Visibility="Collapsed"
                                       Margin="0,8,0,0"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Opacity="0.85"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
