<Window x:Class="CyberSnap.UI.CapturePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberSnap.UI.Controls"
        Title="Capture Preview"
        Height="460" Width="820"
        MinHeight="360" MinWidth="520"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="False"
        Icon="pack://application:,,,/Assets/Icons/CyberSnap.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="ThemeMutedBrush" Color="#FF686868"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="ThemePrimaryButtonForegroundBrush" Color="#FF0B1220"/>

        <Style x:Key="PreviewActionButton" TargetType="Button" BasedOn="{StaticResource ChromeButtonBase}">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewIconButton" TargetType="Button" BasedOn="{StaticResource ChromeButtonBase}">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewPrimaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="16,10"/>
            <!-- Same translucent fill/hover as the optional actions so the whole column
                 reads as one button family; the progress line carries the accent. -->
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:CyberSnapTitleBar x:Name="TitleBar" Grid.Row="0"
                                      Title="Capture Preview"
                                      ShowPinButton="True"
                                      CloseRequested="TitleBar_CloseRequested"
                                      PinRequested="TitleBar_PinRequested"/>

            <!-- Preview (left) + actions (right); stacks when narrow -->
            <Grid x:Name="MainLayout" Grid.Row="1" Margin="14,2,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewCol" Width="*"/>
                    <ColumnDefinition x:Name="ActionsCol" Width="268"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PreviewRow" Height="*"/>
                    <RowDefinition x:Name="ActionsRow" Height="0"/>
                </Grid.RowDefinitions>

                <!-- Image preview -->
                <Border x:Name="PreviewFrame" Grid.Row="0" Grid.Column="0"
                        Margin="0,0,12,0" CornerRadius="10" Padding="0"
                        BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Border x:Name="CheckerboardHost" CornerRadius="9"/>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <!-- Decision column -->
                <Border x:Name="ActionsPanel" Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource ThemeCardBrush}"
                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,12,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- On continue -->
                        <StackPanel Grid.Row="0">
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <Button x:Name="EditAfterCaptureSettingsBtn" DockPanel.Dock="Right"
                                        Click="EditAfterCaptureSettingsBtn_Click"
                                        Style="{StaticResource PreviewIconButton}"
                                        Margin="8,0,0,0"
                                        ToolTip="Configure automatic actions"
                                        AutomationProperties.Name="Configure automatic actions">
                                    <Image x:Name="EditSettingsBtnIcon" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock x:Name="AfterCaptureHeaderLabel"
                                           Text="Active actions:"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <StackPanel x:Name="AfterCapturePillsPanel" Orientation="Vertical"/>

                            <TextBlock x:Name="NoAutomaticActionsLabel"
                                       Text="None"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource ThemeMutedBrush}"/>
                        </StackPanel>

                        <!-- You can also -->
                        <StackPanel x:Name="OptionalActionsSection" Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock x:Name="OptionalActionsHeaderLabel"
                                       Text="You can also:"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       Margin="0,0,0,8"
                                       TextTrimming="CharacterEllipsis"/>

                            <WrapPanel x:Name="OptionalActionsPanel" Orientation="Horizontal">
                                <Button x:Name="SaveBtn" Click="SaveBtn_Click"
                                        Style="{StaticResource PreviewActionButton}"
                                        Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="SaveIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SaveText" Text="Save" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CopyBtn" Click="CopyBtn_Click"
                                        Style="{StaticResource PreviewActionButton}"
                                        Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="CopyIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CopyText" Text="Copy" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="EditBtn" Click="EditBtn_Click"
                                        Style="{StaticResource PreviewActionButton}"
                                        Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="EditIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="EditText" Text="Edit" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MoreBtn" Click="MoreBtn_Click"
                                        Style="{StaticResource PreviewActionButton}"
                                        Margin="0,0,6,6"
                                        ToolTip="More">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="MoreIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MoreText" Text="More" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Hidden action hosts kept for Share/Gallery (opened via More menu) -->
                            <Button x:Name="ShareBtn" Click="ShareBtn_Click" Visibility="Collapsed" Height="0" Width="0" Padding="0"/>
                            <Button x:Name="GalleryBtn" Click="GalleryBtn_Click" Visibility="Collapsed" Height="0" Width="0" Padding="0"/>
                            <Image x:Name="ShareIcon" Width="0" Height="0" Visibility="Collapsed"/>
                            <Image x:Name="GalleryIcon" Width="0" Height="0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Primary CTA + auto-close progress flush to button bottom (toast-style). -->
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <Border x:Name="DoneButtonHost"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    SizeChanged="DoneButtonHost_SizeChanged">
                                <Grid>
                                    <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                                            Style="{StaticResource PreviewPrimaryButton}"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="CancelIcon" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CancelText" Text="Done" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Auto-close countdown — quiet overlay on the button's top-right corner.
                                         Opacity stays at 1 so fade animations drive it explicitly;
                                         a 40%-alpha white Foreground carries the resting dimness. -->
                                    <TextBlock x:Name="AutoCloseCountdownText"
                                               Margin="0,4,10,0"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Right"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#66FFFFFF"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False"/>

                                    <Grid x:Name="ProgressHost"
                                          Height="2.5"
                                          VerticalAlignment="Bottom"
                                          IsHitTestVisible="False"
                                          Visibility="Collapsed">
                                        <Border x:Name="ProgressTrack" HorizontalAlignment="Stretch"/>
                                        <Border x:Name="ProgressBar"
                                                HorizontalAlignment="Stretch"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#FF00F2FF" Offset="0.0"/>
                                                    <GradientStop Color="#FF7A00FF" Offset="0.5"/>
                                                    <GradientStop Color="#FFFF00D0" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="ProgressScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ViewerHintBadge"
                                       Text=""
                                       Visibility="Collapsed"
                                       Margin="0,8,0,0"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Opacity="0.85"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
